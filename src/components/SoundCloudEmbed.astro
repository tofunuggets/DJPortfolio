---
interface Props {
  profileUrl?: string;
  height?: number;
}

const {
  profileUrl = 'https://soundcloud.com/waveassembly',
  height = 450,
} = Astro.props;

const embedUrl = `https://w.soundcloud.com/player/?url=${encodeURIComponent(profileUrl)}&color=%23a855f7&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&visual=true`;
---

<div class="overflow-hidden rounded-2xl border border-white/5 bg-surface/80">
  <iframe
    title="Wave Assembly on SoundCloud"
    width="100%"
    height={height}
    scrolling="no"
    frameborder="no"
    allow="autoplay"
    src={embedUrl}
    class="block w-full"
  ></iframe>
</div>
